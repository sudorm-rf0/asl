# ============================================
# ASL 期货平台 — 环境变量配置示例
# 复制为 .env 并填入实际值:
#   cp .env.example .env
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=changeit
MYSQL_USER=futures
MYSQL_PASSWORD=changeit

# Redis
REDIS_PASSWORD=changeit

# Nacos (JWT secret must be base64-encoded, min 32 bytes)
NACOS_AUTH_TOKEN=your-base64-secret-key-here
NACOS_AUTH_IDENTITY_KEY=futures
NACOS_AUTH_IDENTITY_VALUE=changeit
NACOS_DB_PASSWORD=changeit

# Seata
SEATA_SERVER_ADDR=127.0.0.1:8091

# RocketMQ
ROCKETMQ_NAMESRV_ADDR=localhost:9876

# Grafana
GRAFANA_PASSWORD=changeit

# AllTick API (行情数据)
ITICK_API_KEY=
